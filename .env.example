# InternStellar environment variables
# Copy this file to .env.local and fill in project-specific secrets there.
# .env and .env.local are ignored; never commit real service-role keys or
# Stellar secret keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY — bypasses RLS, server-only. Used by P2's
# /api/escrow/* routes and by scripts/reset-demo.ts.
#
# !! ROTATE if it has ever been committed to git, posted in a screenshot,
# !! or pasted into Slack/Discord. Supabase Dashboard →
# !! Project Settings → API → Reset service_role key, then update this
# !! file's value AND restart any running `next dev` so the new key is
# !! loaded.
SUPABASE_SERVICE_ROLE_KEY=

# Stellar / Soroban network
#
# Default is testnet so local dev, the rehearsal demo.sh, and existing
# tests keep working without changes. To target mainnet, set STELLAR_NETWORK
# to "public" (or "mainnet") AND switch the four URL/passphrase lines below
# to the mainnet block. The app reads these at runtime — no rebuild needed.
#
# --- Testnet (default) -----------------------------------------------------
STELLAR_NETWORK=testnet
# Client-side mirror of STELLAR_NETWORK, used ONLY to pick the Stellar Expert
# base URL for explorer links rendered in the browser. Required because Next.js
# strips non-NEXT_PUBLIC_ env vars from client bundles — without this, client
# components can't read STELLAR_NETWORK and every explorer link silently stays
# on testnet even when the server is on mainnet. Keep it in sync with
# STELLAR_NETWORK (mainnet: set this to "public" too).
NEXT_PUBLIC_STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Mainnet (uncomment + replace the testnet block above to flip) --------
# STELLAR_NETWORK=public
# NEXT_PUBLIC_STELLAR_NETWORK=public
# STELLAR_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# Inclusion fee (MAX bid, stroops per op) for contract calls. Optional.
# Defaults to 1000000 (0.1 XLM) which is mainnet-safe — the network charges
# only the clearing fee (~7k stroops in practice) plus the Soroban resource
# fee, so this is just a generous ceiling. The SDK minimum (100) is too low
# for mainnet and causes deposit/lock/release to surface contract_call_timeout
# (the tx never gets included before its validity window expires). Leave unset
# unless you need to tune it; on testnet the default is harmless.
# STELLAR_BASE_FEE=1000000

# Deployed escrow contract id (network-specific). Update after each deploy.
#   testnet (Day 4): CB3VGM6SU3RRJLRJMT7CRX36ARKCH222ZKGKVPMS2DU5MIAHKUFZGRDF
#   mainnet:         CCSK35NQQR46C7ULBEGL6FG7JJ7XPLR427ZN5HHN2FLBXTZNKT57GKRW
NEXT_PUBLIC_CONTRACT_ID=CB3VGM6SU3RRJLRJMT7CRX36ARKCH222ZKGKVPMS2DU5MIAHKUFZGRDF

# Testnet-only signer used by the API routes to submit demo transactions
# AND by `npm run reset` to Friendbot-fund the demo account.
#
# REQUIRED for rehearsals — chain calls (lock_escrow / release_escrow)
# fail with `contract_not_configured` without it.
#
# How to get one:
#   $ npm run fund-test-account
# That script generates a fresh testnet keypair, hits Friendbot for
# 10,000 XLM, and prints the secret. Paste it here, then also seed the
# demo family's profiles.stellar_public_key with the matching public key
# (the contract calls family.require_auth()).
# Generate one with: npm run fund-test-account
STELLAR_DEMO_SECRET_KEY=
