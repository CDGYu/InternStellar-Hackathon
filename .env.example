# InternStellar environment variables
# Copy this file to .env.local and fill in project-specific secrets there.
# .env and .env.local are ignored; never commit real service-role keys or
# Stellar secret keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stellar / Soroban testnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Day 3 escrow-enabled contract on Stellar testnet.
NEXT_PUBLIC_CONTRACT_ID=CAWU54VCOTXACW5RDQ23DMHMKCFHCRICGEHIGGCDL4GL4X6NP2ZBMPID

# Testnet-only signer used by the API routes to submit demo transactions.
# If the contract requires family.require_auth(), seed the demo family's
# profiles.stellar_public_key with this keypair's public key.
STELLAR_DEMO_SECRET_KEY=
